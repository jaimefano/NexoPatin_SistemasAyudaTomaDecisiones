# Copia este fichero como .env y rellena los valores antes de arrancar con docker compose.
# Contraseña del administrador (usuario "admin"). Solo se aplica la primera vez, al crear la base de datos.
SATD_ADMIN_CLAVE=cambia-esta-contraseña
# Pon 1 cuando la web se sirva por HTTPS.
SATD_COOKIE_SEGURA=0
